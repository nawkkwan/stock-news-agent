ARG HERMES_BASE_IMAGE="nousresearch/hermes-agent@sha256:da8ac38dbdddce70cc724e1eff04cc0732787531cbdb00c45fb059b13918229d"
FROM ${HERMES_BASE_IMAGE}

USER root

COPY infra/hermes/config.yaml /opt/hermes-seed/config.yaml
COPY integrations/hermes/portfolio-agent /opt/hermes-seed/skills/finance/portfolio-agent
COPY docker/start-hermes.sh /etc/cont-init.d/00-portfolio-hermes
RUN chmod 0755 /etc/cont-init.d/00-portfolio-hermes
