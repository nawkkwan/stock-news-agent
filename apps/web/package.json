    "@supabase/ssr": "^0.12.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.3.0",
    "typescript": "5.8.2",
    "wrangler": "^4.131.1"
  }
}
